  "cards": [
    {
      "dot": "cyan",
      "title": "Edge & identity",
      "items": [
        "Ocelot maps /{service}/api/** to {service}-service:8080",
        "Bearer auth on every route except login, register, refresh",
        "Aspire injects Jwt__SecretKey into the gateway and all services"
      ]
    },
    {
      "dot": "emerald",
      "title": "Services & data",
      "items": [
        "Nine .NET 10 services on 6001-6009, Clean Architecture in each",
        "SQL Server myapp-sqlserver holds one {Service}DB per service",
        "Redis backs Dapr state plus ICacheService cache-aside"
      ]
    },
    {
      "dot": "amber",
      "title": "Events",
      "items": [
        "Dapr pub/sub component \"pubsub\" over Redis, sidecars from 3501",
        "Topics: sales.*, crm.*, orders.*, inventory.*, purchasing.*, audit.*",
        "Subscribers are [Topic] controllers under /api/events/*"
      ]
    }
  ]
